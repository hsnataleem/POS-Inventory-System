# Server Environment Configuration Template
PORT=8080
JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE

# Seed passwords (required when running npm run seed)
ADMIN_PASSWORD=your_admin_password
MANAGER_PASSWORD=your_manager_password
CASHIER_PASSWORD=your_cashier_password

# PostgreSQL Database config (Used when USE_SQLITE is false/unset)
# Railway: reference Postgres service vars or use DATABASE_URL directly
DATABASE_URL=
DB_NAME=pos_inventory_db
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD
DB_HOST=localhost
DB_PORT=5432

# Set to true to use sqlite database instead of postgres
USE_SQLITE=true
